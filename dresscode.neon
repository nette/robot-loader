use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/fixtures*
	- tests/Loaders/file
	- tests/Loaders/files

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
