{
	"name": "nette/robot-loader",
	"description": "🍀 Nette RobotLoader: autoloads every class, interface, trait and enum in your directories, with no PSR-4 and no naming rules, and remembers where it found them.",
	"keywords": ["nette", "autoload", "autoloader", "class loader", "classmap"],
	"homepage": "https://doc.nette.org/robot-loader",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.1 - 8.6",
		"ext-tokenizer": "*",
		"nette/utils": "^4.0.6"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"tracy/tracy": "^2.9",
		"phpstan/phpstan": "^2.1.39@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "4.1-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
